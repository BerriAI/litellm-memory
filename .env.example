# Portable deployment. scripts/self-host.sh generates .env.selfhost for you.
PUBLIC_BASE_URL=http://localhost:8000
ALLOWED_EMAIL_DOMAIN=berri.ai
POSTGRES_PASSWORD=
# Optional: otherwise generated and stored privately at first boot.
SETUP_CODE=
# Connect LiteLLM and Slack in the browser after deployment.
# Leave sharing off until the installation is ready.
SHARING_ENABLED=false
SEARCH_CACHE_MB=128
RECOVERY_MODE=false

# Optional Pydantic Logfire: set both values and restart.
# See docs/observability.md. No prompts, answers or personal identities are exported.
OBSERVABILITY_EXPORT=none
LOGFIRE_TOKEN=
# Alternative to Logfire cloud when OBSERVABILITY_EXPORT=otlp:
OTLP_TRACES_ENDPOINT=

# A private topic blocks sharing at or above this Jev probability (0 < value <= 1).
# Changing it rechecks existing cached scores on restart; it never adds sharing consent.
JEV_PRIVATE_THRESHOLD=0.7
