LITELLM_BASE_URL=https://your-gateway.example/v1
LITELLM_API_KEY=
LITELLM_MODEL=openai/gpt-5.6-luna
MEMORY_EMBEDDING_MODEL=openai/text-embedding-3-small
MEMORY_EMBEDDING_VERSION=1
MEMORY_REPO=BerriAI/product-team-knowledge
MEMORY_ALLOWED_ACTORS=moe-berri
GH_TOKEN=
PUBLIC_BASE_URL=http://localhost:8000
SESSION_SECRET=
ACCESS_MODE=public
# Enable later with ACCESS_MODE=allowlist, using verified Slack workspace:user pairs.
ALLOWED_SLACK_USERS=
SLACK_TEAM_ID=
SLACK_OWNER_USER_ID=
SLACK_APP_ID=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=
# Set only for a manually installed app. The OAuth install flow persists these to SQLite.
SLACK_BOT_TOKEN=
SLACK_BOT_USER_ID=
# Optional, if your gateway exposes a search route accessible with this key.
LITELLM_SEARCH_TOOL=
